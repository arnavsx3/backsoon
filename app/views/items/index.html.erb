<% content_for :title, "Your things · Backsoon" %>
<%= render "shared/page_header", title: "A few favorite things.", subtitle: "The books, tools, and little everyday essentials you are happy to share.", action: { label: "+ Add an item", url: new_item_path } %>
<% if @items.any? %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @items.each do |item| %>
      <%= link_to item, class: "card flex flex-col p-6 transition hover:border-brand" do %>
        <span class="grid size-12 place-items-center rounded-xl bg-[#eff2ea] text-sm font-bold text-brand"><%= initials(item.name) %></span>
        <h2 class="mt-5 font-semibold wrap-anywhere"><%= item.name %></h2>
        <p class="mt-2 line-clamp-2 text-sm leading-6 text-muted"><%= item.description.presence || "Ready for its next little adventure." %></p>
        <div class="mt-auto pt-5"><span class="badge <%= item.outstanding_loan ? "bg-orange-50 text-orange-800" : "bg-teal-50 text-teal-800" %>"><%= item.outstanding_loan ? "With #{item.outstanding_loan.borrower.name}" : "Available" %></span></div>
      <% end %>
    <% end %>
  </div>
  <%= render "shared/pagination" %>
<% else %>
  <%= render "shared/empty_state", title: "Start with something you share.", description: "Add your first item. A book, a spare charger, or that tool everyone asks to borrow.", action: { label: "Add your first item", url: new_item_path } %>
<% end %>
