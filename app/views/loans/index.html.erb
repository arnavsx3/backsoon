<% content_for :title, "Your loans · Backsoon" %>
<%= render "shared/page_header", eyebrow: "A little less on your mind", title: "Out in the world.", subtitle: "Keep track of the things making somebody else’s day. We will remember the details.", action: { label: "+ Record a loan", url: new_loan_path } %>
<div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
  <% [["Out on loan", @counts[:outstanding], "Things enjoying a change of scenery.", "↗"], ["Past their due date", @counts[:overdue], "Maybe time for a friendly check-in.", "◷"], ["Back home", @counts[:returned], "Little handoffs, happily completed.", "↩"]].each_with_index do |(label, count, hint, icon), index| %>
    <div class="card p-6"><div class="flex items-center justify-between"><p class="text-xs font-semibold text-muted"><%= label %></p><span class="grid size-8 place-items-center rounded-lg <%= index == 1 ? "bg-orange-50 text-orange-700" : "bg-[#eef2eb] text-brand" %>" aria-hidden="true"><%= icon %></span></div><p class="mt-4 text-4xl font-semibold tracking-tight <%= 'text-coral' if index == 1 && count.positive? %>"><%= count %></p><p class="mt-3 text-xs leading-5 text-muted"><%= hint %></p></div>
  <% end %>
</div>
<section aria-label="Your lending records">
  <div class="mb-5 flex flex-wrap items-center justify-between gap-4">
    <nav aria-label="Filter loans" class="flex flex-wrap gap-1 rounded-xl border border-line bg-white p-1">
      <% [["Outstanding", "outstanding"], ["Overdue", "overdue"], ["Returned", "returned"], ["All loans", "all"]].each do |label, status| %>
        <%= link_to label, loans_path(status: status, q: @query.presence), aria: { current: @status == status ? "page" : nil }, class: "rounded-lg px-3 py-2 text-xs font-semibold transition #{@status == status ? 'bg-brand text-white' : 'text-muted hover:bg-paper'}" %>
      <% end %>
    </nav>
    <%= form_with url: loans_path, method: :get, class: "flex w-full gap-2 sm:w-auto", role: "search" do |form| %>
      <%= form.hidden_field :status, value: @status %><%= form.label :q, "Search loans", class: "sr-only" %><%= form.search_field :q, value: @query, maxlength: 100, placeholder: "An item or a person…", class: "input mt-0! min-w-0 flex-1 sm:w-56" %><%= form.submit "Search", class: "btn-secondary" %>
    <% end %>
  </div>
  <% if @query.present? %><p class="mb-4 text-sm text-muted">Results for “<%= @query %>” · <%= link_to "Clear search", loans_path(status: @status), class: "font-semibold text-brand underline underline-offset-4" %></p><% end %>
  <% if @loans.any? %>
    <div class="card overflow-hidden divide-y divide-line">
      <div class="hidden grid-cols-[minmax(0,2fr)_minmax(0,1fr)_130px_110px] gap-4 bg-[#fafbf8] px-6 py-4 text-[10px] font-bold tracking-widest text-muted uppercase md:grid"><span>What you lent</span><span>Who has it</span><span>Expected back</span><span>Status</span></div>
      <% @loans.each do |loan| %>
        <%= link_to loan, class: "grid gap-4 px-5 py-5 transition hover:bg-[#fafbf8] md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_130px_110px] md:items-center md:px-6", data: { testid: "loan-row" } do %>
          <div class="flex min-w-0 items-center gap-4"><span class="grid size-11 shrink-0 place-items-center rounded-xl bg-[#eef2eb] text-xs font-bold text-brand"><%= initials(loan.item.name) %></span><div class="min-w-0"><h2 class="text-sm font-semibold wrap-anywhere"><%= loan.item.name %></h2><p class="mt-1 text-xs text-muted">Lent <%= friendly_date(loan.lent_on) %></p></div></div>
          <span class="text-sm wrap-anywhere"><span class="text-muted md:hidden">With </span><%= loan.borrower.name %></span>
          <span class="text-xs <%= loan.overdue? ? 'font-semibold text-coral' : 'text-muted' %>"><span class="md:hidden">Due </span><%= friendly_date(loan.due_on) %></span>
          <span class="badge w-fit <%= loan_status_class(loan) %>"><%= loan_status(loan) %></span>
        <% end %>
      <% end %>
    </div>
    <%= render "shared/pagination" %>
  <% elsif @query.present? %>
    <%= render "shared/empty_state", title: "Nothing by that name.", description: "Try another item or person, or clear your search to see your loans.", action: { label: "Clear search", url: loans_path(status: @status) } %>
  <% elsif @counts.values.sum.zero? %>
    <%= render "shared/empty_state", title: "Your first little handoff.", description: "Add something you own and someone you trust. Then record a loan, and let your memory take a break.", action: { label: "Get started", url: new_loan_path } %>
  <% else %>
    <%= render "shared/empty_state", title: @status == "overdue" ? "Nothing is overdue. Nice." : "Nothing here just yet.", description: "Use the filters to find another part of your lending story.", action: { label: "See all loans", url: loans_path(status: "all") } %>
  <% end %>
</section>
<div class="mt-7 flex items-center gap-3 rounded-xl bg-[#edf1e9] px-5 py-4 text-xs leading-5 text-[#657362]"><span class="text-lg" aria-hidden="true">✧</span><p>A little generosity goes a long way. A little record brings it back.</p></div>
