<% content_for :title, "#{@loan.item.name} · Backsoon" %>
<%= render "shared/page_header", eyebrow: "The little details", title: @loan.item.name, subtitle: "A handoff to #{@loan.borrower.name}.", action: { label: "Edit details", url: edit_loan_path(@loan) } %>
<div class="grid items-start gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
  <section class="card p-6 sm:p-8" aria-label="Loan details">
    <span class="badge <%= loan_status_class(@loan) %>"><%= loan_status(@loan) %></span>
    <dl class="mt-8 grid gap-x-8 gap-y-7 sm:grid-cols-2">
      <div>
        <dt class="eyebrow">What you lent</dt>
        <dd class="mt-2 text-sm font-semibold wrap-anywhere"><%= link_to @loan.item.name, @loan.item, class: "underline decoration-line underline-offset-4" %></dd>
      </div>
      <div>
        <dt class="eyebrow">Who has it</dt>
        <dd class="mt-2 text-sm font-semibold wrap-anywhere"><%= link_to @loan.borrower.name, @loan.borrower, class: "underline decoration-line underline-offset-4" %></dd>
      </div>
      <div>
        <dt class="eyebrow">Lent on</dt>
        <dd class="mt-2 text-sm"><%= friendly_date(@loan.lent_on) %></dd>
      </div>
      <div>
        <dt class="eyebrow">Expected back</dt>
        <dd class="mt-2 text-sm <%= 'font-semibold text-coral' if @loan.overdue? %>"><%= friendly_date(@loan.due_on) %></dd>
      </div>
      <% if @loan.returned? %>
        <div>
          <dt class="eyebrow">Back home on</dt>
          <dd class="mt-2 text-sm"><%= friendly_date(@loan.returned_on) %></dd>
        </div>
      <% end %>
    </dl>
    <% if @loan.notes.present? %>
      <div class="mt-8 border-t border-line pt-6">
        <h2 class="eyebrow">Your note</h2>
        <p class="mt-3 whitespace-pre-wrap wrap-anywhere text-sm leading-7 text-muted"><%= @loan.notes %></p>
      </div>
    <% end %>
  </section>
  <aside class="card p-6 sm:p-8">
    <% if @loan.outstanding? %><span class="text-3xl text-brand" aria-hidden="true">↩</span>
      <h2 class="mt-4 text-lg font-semibold">Found its way back?</h2>
      <p class="mt-3 text-sm leading-6 text-muted">Mark it returned. We will keep the story, and your item will be available to lend again.</p>
      <%= button_to "Mark returned", loan_return_path(@loan), class: "btn mt-6 w-full", form: { data: { turbo_confirm: "Has this item been returned?" } } %>
    <% else %><span class="text-3xl text-brand" aria-hidden="true">✓</span>
      <h2 class="mt-4 text-lg font-semibold">Back where it belongs.</h2>
      <p class="mt-3 text-sm leading-6 text-muted">This handoff is complete. The record stays here for whenever you need it.</p>
      <%= link_to "Lend this item again", new_loan_path(item_id: @loan.item_id), class: "btn mt-6 w-full" unless @loan.item.outstanding_loan %><% end %>
    <%= link_to "Back to your loans", root_path, class: "mt-5 block text-center text-xs font-semibold text-muted hover:text-ink" %>
  </aside>
</div>
