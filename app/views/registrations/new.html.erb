<% content_for :title, "Create an account · Backsoon" %>
<div class="mx-auto grid max-w-4xl gap-8 py-4 lg:grid-cols-2 lg:gap-14 lg:py-10">
  <%= render "shared/auth_intro" %>
  <section class="card w-full p-6 sm:p-9">
    <p class="eyebrow">A little fresh start</p><h1 class="mt-3 text-3xl font-semibold tracking-tight">Make yourself at home.</h1><p class="mt-3 text-sm leading-6 text-muted">Create your private lending notebook.</p>
    <div class="mt-7"><%= render "shared/errors", record: @user %></div>
    <%= form_with model: @user, url: registration_path, class: "space-y-5" do |form| %>
      <div><%= form.label :email_address, "Email address", class: "label" %><%= form.email_field :email_address, required: true, autocomplete: "email", maxlength: 254, class: "input" %></div>
      <div><%= form.label :password, class: "label" %><%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72, class: "input" %><p class="hint">At least 12 characters. Something just for you.</p></div>
      <div><%= form.label :password_confirmation, "Confirm password", class: "label" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "input" %></div>
      <%= form.submit "Create account", class: "btn w-full", data: { turbo_submits_with: "Creating account…" } %>
    <% end %>
    <p class="mt-7 border-t border-line pt-6 text-center text-sm text-muted">Already settled in? <%= link_to "Sign in", new_session_path, class: "font-semibold text-brand underline underline-offset-4" %></p>
  </section>
</div>
