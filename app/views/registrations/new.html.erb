<section class="mx-auto w-full max-w-md">
  <h1 class="text-3xl font-semibold">Create your account</h1>
  <p class="mt-2 text-gray-600">Your things, your people, your private notebook.</p>
  <div class="mt-6"><%= render "shared/errors", record: @user %></div>
  <%= form_with model: @user, url: registration_path, class: "space-y-5" do |form| %>
    <div><%= form.label :email_address, "Email address" %><%= form.email_field :email_address, required: true, autocomplete: "email", maxlength: 254, class: "mt-2 w-full rounded-lg border p-3" %></div>
    <div><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72, class: "mt-2 w-full rounded-lg border p-3" %><p class="mt-2 text-sm text-gray-500">At least 12 characters.</p></div>
    <div><%= form.label :password_confirmation, "Confirm password" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "mt-2 w-full rounded-lg border p-3" %></div>
    <%= form.submit "Create account", class: "w-full cursor-pointer rounded-lg bg-gray-900 p-3 font-medium text-white" %>
  <% end %>
  <p class="mt-6 text-sm">Already have an account? <%= link_to "Sign in", new_session_path, class: "underline" %></p>
</section>
