<% content_for :title, "Sign in · Backsoon" %>
<div class="mx-auto grid max-w-4xl gap-8 py-4 lg:grid-cols-2 lg:gap-14 lg:py-10">
  <%= render "shared/auth_intro" %>
  <section class="card w-full p-6 sm:p-9">
    <p class="eyebrow">Welcome back</p><h1 class="mt-3 text-3xl font-semibold tracking-tight">Right where you left it.</h1><p class="mt-3 text-sm leading-6 text-muted">Sign in to your Backsoon.</p>
    <%= form_with url: session_path, class: "mt-8 space-y-5" do |form| %>
      <div><%= form.label :email_address, "Email address", class: "label" %><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", maxlength: 254, value: params[:email_address], class: "input" %></div>
      <div><div class="flex items-center justify-between gap-3"><%= form.label :password, class: "label" %><%= link_to "Forgot password?", new_password_path, class: "text-xs font-semibold text-brand" %></div><%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %></div>
      <%= form.submit "Sign in", class: "btn w-full", data: { turbo_submits_with: "Signing in…" } %>
    <% end %>
    <p class="mt-7 border-t border-line pt-6 text-center text-sm text-muted">New around here? <%= link_to "Create an account", new_registration_path, class: "font-semibold text-brand underline underline-offset-4" %></p>
  </section>
</div>
