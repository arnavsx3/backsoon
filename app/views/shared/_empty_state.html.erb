<div class="card px-6 py-14 text-center">
  <span class="mx-auto grid size-14 place-items-center rounded-2xl bg-[#eef2eb] text-2xl text-brand" aria-hidden="true">↩</span>
  <h2 class="mt-5 text-xl font-semibold"><%= title %></h2>
  <p class="mx-auto mt-3 max-w-sm text-sm leading-6 text-muted"><%= description %></p>
  <% if local_assigns[:action] %><%= link_to action[:label], action[:url], class: "btn mt-6" %><% end %>
</div>
