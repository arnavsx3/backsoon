# Local environment and credentials
.env
.env.*
!.env.example
/config/master.key
/config/credentials/*.key

# Local dependencies and generated files
/.bundle/
/vendor/bundle/
/log/*
/tmp/*
/storage/*

# Editor and operating system files
.DS_Store
*.swp

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# Asset builds and empty runtime directories
/public/assets/
!/log/.keep
!/tmp/.keep
!/tmp/pids/
/tmp/pids/*
!/tmp/pids/.keep
!/storage/.keep
