# Supply values through your shell or deployment environment.
# For local development, make dev loads a private .env file through Foreman.
# Direct Rails commands do not automatically load environment files.
APP_TIME_ZONE=UTC
PORT=3000
# Production:
APP_HOST=backsoon.example.com
BACKSOON_STORAGE=/rails/storage
# Generate SECRET_KEY_BASE with: bin/rails secret
# SECRET_KEY_BASE=
SOLID_QUEUE_IN_PUMA=1
# Optional SMTP delivery for password resets in development and production.
# Without it, messages remain in private local storage.
# SMTP_ADDRESS=
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=Backsoon <noreply@your-domain.example>
