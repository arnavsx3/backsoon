# Copy values into your shell or deployment environment. Rails does not auto-load this file.
APP_TIME_ZONE=UTC
PORT=3000
# Production:
APP_HOST=backsoon.example.com
BACKSOON_STORAGE=/rails/storage
# Generate SECRET_KEY_BASE with: bin/rails secret
# SECRET_KEY_BASE=
SOLID_QUEUE_IN_PUMA=1
# Optional SMTP delivery for password resets. Without it, messages remain in private local storage.
# SMTP_ADDRESS=
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=Backsoon <noreply@your-domain.example>
